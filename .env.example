# 루트 공통 환경변수 — 각 서비스 폴더의 .env.example도 참고하세요.
# Supabase 프로젝트 Settings > API에서 확인.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...                 # 프론트엔드용 (RLS 적용)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...         # 백엔드 전용 — 절대 프론트에 노출 금지
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET             # JWT 서명 검증용 (Settings > API > JWT Settings)
SUPABASE_DB_PASSWORD=                           # 직접 psql 접속 시에만 사용
